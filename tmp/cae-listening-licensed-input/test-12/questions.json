        },
        {
          "number": 2,
          "type": "multiple-choice",
          "prompt": "What does Charles suggest about a good product?",
          "options": [
            {
              "id": "A",
              "label": "Its appearance should reflect its function."
            },
            {
              "id": "B",
              "label": "It should encourage a desire to possess it."
            },
            {
              "id": "C",
              "label": "Its ecological impact should be considered."
            }
          ]
        },
        {
          "number": 3,
          "type": "multiple-choice",
          "prompt": "They agree that the interviewer made the mistake of",
