    {
      "partNumber": 3,
      "rangeLabel": "Questions 15-20",
      "instruction": "You will hear part of an interview with two sports psychologists called Sheila Forbes and Peter Maxton. For questions 15-20, choose the answer (A, B, C or D) which fits best according to what you hear.",
      "matchingDualTask": false,
      "questions": [
        {
          "number": 15,
          "type": "multiple-choice",
          "prompt": "Sheila explains that her role involves",
          "options": [
            {
              "id": "A",
              "label": "preventing players from becoming over-confident."
            },
            {
              "id": "B",
              "label": "responding to whatever players feel they need to improve."
            },
            {
              "id": "C",
              "label": "enabling players to train aggressively."
            },
            {
              "id": "D",
              "label": "persuading players that her techniques can really benefit them."
            }
          ]
        },
        {
          "number": 16,
          "type": "multiple-choice",
          "prompt": "Sheila says one strategy she uses to achieve her goals is to",
          "options": [
            {
              "id": "A",
              "label": "encourage players to replicate good features of others’ performance."
            },
            {
              "id": "B",
              "label": "ask players to share with her the way they control their anxieties."
            },
            {
              "id": "C",
              "label": "get players to examine their effectiveness as team members."
            },
            {
              "id": "D",
              "label": "trace the causes of negative thinking in players."
            }
          ]
        },
        {
          "number": 17,
          "type": "multiple-choice",
          "prompt": "Sheila and Peter both think that it’s important for sports psychologists",
          "options": [
            {
              "id": "A",
              "label": "to have wide experience in a range of different sports."
            },
            {
              "id": "B",
              "label": "not to raise false hopes about what they can achieve."
            },
            {
              "id": "C",
              "label": "not to become too immersed in the environment of sport."
            },
            {
              "id": "D",
              "label": "to adapt the decisions they make to suit individual situations."
            }
          ]
        },
        {
          "number": 18,
          "type": "multiple-choice",
          "prompt": "What was Peter’s reaction to his deteriorating sporting performance as a student?",
          "options": [
            {
              "id": "A",
              "label": "He felt disappointed at the lack of relevant help available."
            },
            {
              "id": "B",
              "label": "He redoubled his efforts to succeed despite failing health."
            },
            {
              "id": "C",
              "label": "He became desperate to uncover the source of his problem."
            },
            {
              "id": "D",
              "label": "He switched to what he felt were easier sports to succeed in."
            }
          ]
        },
        {
          "number": 19,
          "type": "multiple-choice",
          "prompt": "What does Peter dislike about his job?",
          "options": [
            {
              "id": "A",
              "label": "needing always to be creative in his choice of techniques"
            },
            {
              "id": "B",
              "label": "having constantly to work in different environments"
            },
            {
              "id": "C",
              "label": "being criticised for ineffective working methods"
            },
            {
              "id": "D",
              "label": "feeling he has to justify his achievements to others"
            }
          ]
        },
        {
          "number": 20,
          "type": "multiple-choice",
          "prompt": "When talking about their profession, Shelia and Peter agree that",
          "options": [
