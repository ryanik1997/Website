      "partNumber": 1,
      "rangeLabel": "Questions 1-6",
      "instruction": "You will hear three different extracts. For questions 1-6, choose the answer (A, B or C) which fits best",
      "matchingDualTask": false,
      "questions": [
        {
          "number": 1,
          "type": "multiple-choice",
          "prompt": "What point does the tutor make about a teacher’s attitude?",
          "options": [
            {
              "id": "A",
              "label": "A good teacher can put any subject across effectively."
            },
            {
              "id": "B",
              "label": "Students will pick up on a teacher’s commitment."
            },
            {
              "id": "C",
              "label": "There’s little point in a teacher trying to fake passion for a subject."
            }
          ]
        },
        {
          "number": 2,
          "type": "multiple-choice",
          "prompt": "What is Susanna doing?",
          "options": [
            {
              "id": "A",
              "label": "complaining about her students’ lack of enthusiasm"
            },
            {
              "id": "B",
              "label": "proposing ways of making her subject more appealing"
            },
            {
              "id": "C",
              "label": "asking for ideas about exercises her students could do"
            }
          ]
        },
        {
          "number": 3,
          "type": "multiple-choice",
          "prompt": "Sam is trying to",
          "options": [
            {
              "id": "A",
              "label": "suggest how the visual impact could have been improved."
            },
            {
              "id": "B",
              "label": "challenge Ella’s preconceptions about the music."
            },
            {
              "id": "C",
              "label": "persuade Ella to go to a similar one in the future."
            }
          ]
        },
        {
          "number": 4,
          "type": "multiple-choice",
          "prompt": "In Sam’s opinion, what makes the performer stand out?",
          "options": [
            {
              "id": "A",
              "label": "the influence her academic background has on her music"
            },
            {
              "id": "B",
              "label": "the instinctive way she responds to her audience"
            },
            {
              "id": "C",
              "label": "the high level of stage presence she displays"
            }
          ]
        },
        {
          "number": 5,
          "type": "multiple-choice",
          "prompt": "Staff have been planting trees in order to",
          "options": [
            {
              "id": "A",
              "label": "promote a desirable image."
            },
            {
              "id": "B",
              "label": "encourage a spirit of mutual co-operation."
            },
            {
              "id": "C",
              "label": "compensate for environmental damage."
