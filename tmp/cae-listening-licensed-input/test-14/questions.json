    {
      "partNumber": 3,
      "rangeLabel": "Questions 15-20",
      "instruction": "You will hear an interview in which a historian called Mark Connor and a writer called Judith Monroe are talking about the history of the underground railway in London. For questions 15-20, choose the answer (A, B, C or D) which fits best according to what you hear.",
      "matchingDualTask": false,
      "questions": [
        {
          "number": 15,
          "type": "multiple-choice",
          "prompt": "Mark says that the problems which led to the creation of the railway",
          "options": [
            {
              "id": "A",
              "label": "resulted from poor urban planning."
            },
            {
              "id": "B",
              "label": "were similar to those we have today."
            },
            {
              "id": "C",
              "label": "typified the thinking of their age."
            },
            {
              "id": "D",
              "label": "only had one possible solution."
            }
          ]
        },
        {
          "number": 16,
          "type": "multiple-choice",
          "prompt": "Judith believes that the engineering methods used to make the first tunnel",
          "options": [
            {
              "id": "A",
              "label": "worked surprisingly quickly."
            },
            {
              "id": "B",
              "label": "were too basic to be efficient."
            },
            {
              "id": "C",
              "label": "caused a minimum amount of disruption."
            },
            {
              "id": "D",
              "label": "resulted in the loss of too many homes."
            }
          ]
        },
        {
          "number": 17,
          "type": "multiple-choice",
          "prompt": "How does Mark feel about the public reaction when the first underground line opened?",
          "options": [
            {
              "id": "A",
              "label": "disappointed by their reluctance to go underground"
            },
            {
              "id": "B",
              "label": "struck by their willingness to tolerate lengthy journeys"
            },
            {
              "id": "C",
              "label": "amused by their unfounded fears"
            },
            {
              "id": "D",
              "label": "impressed by their general enthusiasm"
            }
          ]
        },
        {
          "number": 18,
          "type": "multiple-choice",
          "prompt": "Judith and Mark both say that, during the early years of its construction, the railway",
          "options": [
            {
              "id": "A",
              "label": "created many jobs for people."
