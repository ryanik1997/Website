{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--cdp-endpoint",
        "http://localhost:9222"
      ]
    },
    "claude-mem": {
      "cwd": ".",
      "command": "node",
      "args": [
        "./mcps/local-tool-bundles-mcp/server.mjs",
        "claude-mem"
      ]
    },
    "codebase-memory": {
      "cwd": ".",
      "command": "node",
      "args": [
        "./mcps/local-tool-bundles-mcp/server.mjs",
        "codebase-memory"
      ]
    },
    "codebase-memory-mcp": {
      "cwd": ".",
      "command": "node",
      "args": [
        "./mcps/local-tool-bundles-mcp/server.mjs",
        "codebase-memory-mcp"
      ]
    }
  }
}
