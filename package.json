{
  "name": "ryan-english",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm run dev:open",
    "dev:full": "pnpm --stream --parallel --filter web --filter server dev",
    "dev:open": "pnpm --stream --parallel --filter server dev --filter web dev:open",
    "dev:web": "pnpm --filter web dev",
    "dev:web:open": "pnpm --filter web dev:open",
    "build:catalog": "node scripts/build-catalog.mjs && node scripts/mode-c-pack-catalog.mjs && node scripts/validate-catalog-runtime.mjs",
    "build:catalog:if-present": "node scripts/build-catalog.mjs --if-present && node scripts/mode-c-pack-catalog.mjs && node scripts/validate-catalog-runtime.mjs",
    "build:catalog:fce-test27": "node scripts/build-catalog.mjs --only-exam catalog-reading-fce-b2-test27 && node scripts/mode-c-pack-catalog.mjs --only-exam catalog-reading-fce-b2-test27 && node scripts/validate-catalog-runtime.mjs",
    "mode-c:pack": "node scripts/mode-c-pack-catalog.mjs && node scripts/validate-catalog-runtime.mjs",
    "test:listening-media": "pnpm --filter web exec vite-node scripts/test-listening-media-policy.mts",
    "test:listening-gap": "pnpm --filter web exec vite-node scripts/test-listening-gap-answers.mts",
    "test:ket-part4": "pnpm --filter web exec vite-node scripts/test-ket-part4-no-double-passage.mts",
